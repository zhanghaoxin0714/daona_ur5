   <property name="styleSheet">
    <string notr="true">    QGroupBox {
        border: 2px solid #bdc3c7;
        border-radius: 5px;
        margin-top: 10px;
    }
    QGroupBox::title {
        subcontrol-origin: margin;
        left: 10px;
        padding: 0 5px;
        color: #0078D7;
        font-weight: bold;
    }
QWidget {
    background-color: #e5e5e5;   /* 更浅的灰白色底色 */
}
QGroupBox QLineEdit {
    background-color: #ffffff !important;
    color: #222222;
}
QGroupBox QListView {
    background-color: #ffffff !important;
    color: #222222;
}
/* 针对 GroupBox 内部的按钮进行设置，保持原有形状 */
QGroupBox QPushButton {
    background-color: #d0d0d0;   /* 一个比 #e5e5e5 稍深的灰色 */
    color: #222222;             /* 深色文字，保证清晰 */
    border: 1px solid #b0b0b0;   /* 边框颜色，让轮廓更分明 */
    /* (这里没有设置 border-radius，所以按钮会是直角的) */
    padding: 5px 10px;
}

/* 鼠标悬停效果 */
QGroupBox QPushButton:hover {
    background-color: #c0c0c0;   /* 悬停时颜色变深 */
    border-color: #a0a0a0;
}

/* 鼠标按下效果 (只改变颜色) */
QGroupBox QPushButton:pressed {
    background-color: #b0b0b0;   /* 按下时颜色最深 */
}</string>
